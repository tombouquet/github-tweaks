{
  "manifest_version": 3,
  "name": "GitHub Tweaks",
  "version": "1.8.0",
  "author": "Tom Bouquet",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "GitHub Tweaks",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "description": "PR image lightbox, a Submit review button and a sticky merge status bar on the Conversation tab, file-type filters with review progress on Files changed, absolute dates everywhere, and file icons, image thumbnails downloads and quick view in repo file lists. Markdown opens as a commentable rich diff, and Copilot buttons are hidden.",
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "src/settings.js",
        "src/content.js",
        "vendor/confetti.min.js",
        "src/pr-review.js",
        "src/absolute-dates.js",
        "src/file-icons-data.js",
        "vendor/highlight.min.js",
        "src/repo-files.js",
        "src/merge-bar.js",
        "src/md-review.js"
      ],
      "run_at": "document_idle",
      "css": [
        "src/hide-copilot.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.svg"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ]
}
