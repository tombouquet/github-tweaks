{
  "manifest_version": 3,
  "name": "GitHub Tweaks",
  "version": "1.11.0",
  "author": "Tom Bouquet",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "GitHub Tweaks",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "description": "Small fixes and extras for GitHub pull requests and repos.",
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "src/settings.js",
        "src/content.js",
        "src/pr-data.js",
        "vendor/confetti.min.js",
        "src/pr-review.js",
        "src/absolute-dates.js",
        "src/file-icons-data.js",
        "vendor/highlight.min.js",
        "src/repo-files.js",
        "src/jump-to-file.js",
        "src/readme-toc.js",
        "src/md-outline.js",
        "src/merge-status.js",
        "src/merge-bar.js",
        "src/notify-ready.js",
        "src/merge-hint.js",
        "src/hide-checks-tab.js",
        "src/friday.js",
        "src/since-review.js",
        "src/claude-code.js",
        "src/md-review.js"
      ],
      "run_at": "document_idle",
      "css": [
        "src/hide-copilot.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.svg"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ]
}
